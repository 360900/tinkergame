# TinkerGame option schema -- single source of truth for config options.
# Format: scope<TAB>key<TAB>default_expr<TAB>desc_expr
#   scope         url | gui | global | default_template
#   default_expr  verbatim bash expression used as default (empty = none);
#                 lib/config/defaults.sh is GENERATED from this column
#                 by tools/gen-options.sh -- do not edit the generated file.
#   desc_expr     comment template written above the key in config files:
#                 $VAR references are expanded at write time;
#                 $(strFix "$A" "$B") is supported; plain text is literal.
# Row order defines the order keys are written to config files.
# Scopes with no default_expr rows (gui) get no defaults function emitted.


# ---- url ----
url	PROJECTPAGE	$GHURL/360900/tinkergame	
url	CP_PROTONGE	$GHURL/GloriousEggroll/proton-ge-custom	Proton GE DL URL
url	CP_PROTONTKG	$GHURL/Frogging-Family/wine-tkg-git	Proton TKG DL URL
url	CP_PROTONSTL	$GHURL/sonic2kk/steamtinkerlaunch-tweaks	Proton STL DL URL
url	CW_KRON4EK	$GHURL/Kron4ek/Wine-Builds/releases	Wine Kron4ek URL
url	CW_LUTRIS	$GHURL/lutris/wine/releases	Lutris Wine URL
url	CW_WINEGE	$GHURL/GloriousEggroll/wine-ge-custom/releases	Wine-GE URL
url	DL_D3D47_64	https://lutris.net/files/tools/dll/$D3D47	d3d47 64bit DL URL 
url	DL_D3D47_32	http://dege.freeweb.hu/dgVoodoo2/bin/D3DCompiler_47.zip	d3d47 32bit DL URL
url	DXVKURL	$GHURL/doitsujin/dxvk	Dxvk Project URL
url	RESHADEDLURL	https://reshade.me/downloads	${RESH} DL URL
url	RESHADEPROJURL	https://github.com/crosire/reshade	${RESH} Project URL
url	VORTEXPROJURL	$GHURL/Nexus-Mods/${VTX^}	${VTX^} Project URL
url	XLIVEURL	$GHURL/ThirteenAG/Ultimate-ASI-Loader/releases/latest/download/Ultimate-ASI-Loader.zip	Xlive DL URL
url	STASSURL	https://steamcdn-a.akamaihd.net/steam/apps	Steam Asset URL
url	WINETRICKSURL	$GHURL/Winetricks/winetricks	winetricks URL
url	X64DBGURL	$GHURL/x64dbg/x64dbg/releases/tag/snapshot	x64dbg URL
url	BASESTEAMGRIDDBAPI	https://www.steamgriddb.com/api/v2	SteamGridDB Api URL
url	CONTYRELURL	$GHURL/Kron4ek/Conty/releases	Conty DL URL
url	MO2PROJURL	$GHURL/ModOrganizer2/modorganizer	Mod Organizer 2 Project URL
url	HMMPROJURL	$GHURL/thesupersonic16/HedgeModManager	HedgeModManager Project URL
url	SPEKPROJURL	$GHURL/SpecialKO/SpecialK	SpecialK Project URL
url	DPRSRELURL	$GHURL/${DPRS}/${DPRS}/releases	$DPRS DL URL
url	DEPURL	$GHURL/lucasg/${DEPS}/releases	$DEPS URL
url	SPEKURL	https://sk-data.special-k.info/	$SPEK URL
url	SPEKGHURL	$GHURL/${SPEK}O/${SPEK}/releases	$SPEK GH URL
url	SPEKCOMPURL	https://www.pcgamingwiki.com/wiki/List_of_games_compatible_with_Special_K#Compatibility_list	$SPEK compatibility URL
url	FWSURL	https://www.${FWS,,}.org/fws	$FWS DL URL
url	YAIURL	$GHURL/sonic2kk/steamtinkerlaunch-tweaks/releases/download	$YAD appimage url
url	WINERELOADURL	https://gist.githubusercontent.com/rbernon/cdbdc1b0e892f91e7449fcf3dda80bb7/raw/d8cf549bf751d99ed0fe515e36f99ff5c01b7287	wine reload URL
url	GEOELFURL	http://helixmod.blogspot.com/2022/06/announcing-new-geo-11-3d-driver.html	$GEOELF url
url	WDIBURL	$AGHURL/repos/0e4ef622/$WDIB/releases/latest	$WDIBURL url
url	OVRFSRURL	$GHURL/fholger/$OVFS/releases	OpenVR-FSR Project URL
url	UUUURL	https://framedsc.github.io/GeneralGuides/universal_ue4_consoleunlocker.htm#downloading-the-uuu	UUU DL URL
url	IGCSZIP	$GHURL/FransBouma/InjectableGenericCameraSystem/releases/download/IGCSInjector_102/IGCSInjector_v102.zip	IGCS Injector DL URL

# ---- gui ----
gui	WINX		Settings Selection GUI:
gui	WINY		
gui	POSX		
gui	POSY		

