#!/usr/bin/env bash
# shellcheck source=/dev/null
# shellcheck disable=SC1090,SC2034
# TinkerGame -- GPLv3, see LICENSE.
# Thin entry point: the application lives in lib/ modules sourced below in order.
# This next line is rewritten by "make install" (PREFIX):
PREFIX="/usr"

# ---- library resolution -------------------------------------------------
# 1. $TINKERGAME_LIBDIR (explicit override, e.g. DESTDIR install tests)
# 2. lib/ next to this script (development checkout)
# 3. $PREFIX/share/tinkergame/lib (installed)
if [ -n "${TINKERGAME_LIBDIR:-}" ] && [ -d "${TINKERGAME_LIBDIR}" ]; then
	TG_LIBDIR="${TINKERGAME_LIBDIR}"
else
	TG_ENTRYDIR="$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")" && pwd -P)"
	if [ -f "${TG_ENTRYDIR}/lib/core/common.sh" ]; then
		TG_LIBDIR="${TG_ENTRYDIR}/lib"
	else
		TG_LIBDIR="${PREFIX}/share/tinkergame/lib"
	fi
fi

if [ ! -f "${TG_LIBDIR}/core/common.sh" ]; then
	echo "TinkerGame: library directory not found (looked in TG_LIBDIR=\"${TG_LIBDIR}\")" >&2
	echo "Set TINKERGAME_LIBDIR or reinstall TinkerGame." >&2
	exit 1
fi

# Paths of library sources that modules inspect at runtime (self-grep sites):
TGSRC_COMMON="$TG_LIBDIR/core/common.sh"
TGSRC_PATHS="$TG_LIBDIR/core/paths.sh"
TGSRC_MENUCORE="$TG_LIBDIR/gui/menu-core.sh"
TGSRC_SETENTRIES="$TG_LIBDIR/gui/settings-entries.sh"
TGSRC_CMDLINE="$TG_LIBDIR/cli/dispatch.sh"
TGSRC_CLEANUP="$TG_LIBDIR/core/cleanup.sh"

# Option schema (single source of truth for config keys):
TGOPTDEF="$TG_LIBDIR/../data/options.def"

# ---- module manifest (order matters) -------------------------------------
source "$TG_LIBDIR/core/common.sh"
source "$TG_LIBDIR/core/paths.sh"
source "$TG_LIBDIR/steam/libraries.sh"
source "$TG_LIBDIR/gui/geometry.sh"
source "$TG_LIBDIR/launch/args.sh"
source "$TG_LIBDIR/gui/prepare.sh"
source "$TG_LIBDIR/core/i18n.sh"
source "$TG_LIBDIR/launch/proton.sh"
source "$TG_LIBDIR/config/schema.sh"
source "$TG_LIBDIR/config/defaults.sh"
source "$TG_LIBDIR/config/save.sh"
source "$TG_LIBDIR/core/notify.sh"
source "$TG_LIBDIR/launch/proton-vars.sh"
source "$TG_LIBDIR/tools/download.sh"
source "$TG_LIBDIR/gui/menu-core.sh"
source "$TG_LIBDIR/gui/settings-entries.sh"
source "$TG_LIBDIR/gui/menus.sh"
source "$TG_LIBDIR/gui/tabs.sh"
source "$TG_LIBDIR/gui/search.sh"
source "$TG_LIBDIR/core/log.sh"
source "$TG_LIBDIR/core/update.sh"
source "$TG_LIBDIR/config/migrate.sh"
source "$TG_LIBDIR/config/load.sh"
source "$TG_LIBDIR/launch/exec.sh"
source "$TG_LIBDIR/launch/vr.sh"
source "$TG_LIBDIR/launch/reshade.sh"
source "$TG_LIBDIR/launch/specialk.sh"
source "$TG_LIBDIR/gui/dialogs.sh"
source "$TG_LIBDIR/config/manage.sh"
source "$TG_LIBDIR/launch/gamescope.sh"
source "$TG_LIBDIR/launch/custom.sh"
source "$TG_LIBDIR/launch/prefix.sh"
source "$TG_LIBDIR/mods/hmm.sh"
source "$TG_LIBDIR/mods/vortex.sh"
source "$TG_LIBDIR/mods/mo2.sh"
source "$TG_LIBDIR/tools/deps.sh"
source "$TG_LIBDIR/core/deps.sh"
source "$TG_LIBDIR/launch/pipeline.sh"
source "$TG_LIBDIR/launch/start.sh"
source "$TG_LIBDIR/cli/compat.sh"
source "$TG_LIBDIR/core/util.sh"
source "$TG_LIBDIR/cli/help.sh"
source "$TG_LIBDIR/cli/dispatch.sh"
source "$TG_LIBDIR/launch/postrun.sh"
source "$TG_LIBDIR/tools/debug.sh"
source "$TG_LIBDIR/core/vdf.sh"
source "$TG_LIBDIR/steam/config-vdf.sh"
source "$TG_LIBDIR/gui/settings.sh"
source "$TG_LIBDIR/steam/nonsteam.sh"
source "$TG_LIBDIR/core/cleanup.sh"
source "$TG_LIBDIR/launch/firstinstall.sh"
source "$TG_LIBDIR/deck/deck.sh"
source "$TG_LIBDIR/core/bootstrap.sh"

# ---- bootstrap -------------------------------------------------------------
if [ "${TINKERGAME_NO_MAIN:-0}" != 1 ]; then
	if [ "$EUID" = 0 ]; then
		echo "'$PROGCMD' is not meant to be run as root - Exiting"
	else
		main "$@"
	fi
fi
