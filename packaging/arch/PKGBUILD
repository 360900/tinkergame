pkgname=tinkergame
pkgver=14.0.20260805
pkgrel=1
pkgdesc='Steam compatibility tool and game utility manager'
arch=('any')
url='https://github.com/360900/tinkergame'
license=('GPL-3.0-or-later')
depends=('bash' 'git' 'jq' 'tar' 'unzip' 'wget' 'xdotool' 'xxd' 'xorg-xprop' 'xorg-xrandr' 'xorg-xwininfo' 'yad')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	make build
}

package() {
	cd "$pkgname-$pkgver"
	make PREFIX=/usr DESTDIR="$pkgdir" install
}
